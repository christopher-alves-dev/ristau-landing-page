---
import Layout from "../layouts/Layout.astro";
import HeroSlider from "../components/hero/HeroSlider";
import HomeSections from "../components/HomeSections";
import { loadHome, loadProducts, loadSite } from "../data/content";
import { structuredData } from "../data/seo";

const [products, site, home] = await Promise.all([loadProducts(), loadSite(), loadHome()]);
const jsonLd = structuredData({ site, products, home, url: new URL("/", Astro.site) });
---

<Layout title={site.seoTitle} description={site.seoDescription} siteName={site.brand}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd).replaceAll("<", "\\u003c")} />
  <HeroSlider client:load products={products} site={site} />
  <HomeSections {...home} site={site} products={products} />
</Layout>
