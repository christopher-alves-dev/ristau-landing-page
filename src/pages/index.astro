---
import Layout from "../layouts/Layout.astro";
import HeroSlider from "../components/hero/HeroSlider";
import HomeSections from "../components/HomeSections";
import { loadHome, loadProducts, loadSite } from "../data/content";

const [products, site, home] = await Promise.all([loadProducts(), loadSite(), loadHome()]);
---

<Layout title={site.seoTitle} description={site.seoDescription}>
  <HeroSlider client:load products={products} site={site} />
  <HomeSections {...home} site={site} />
</Layout>
