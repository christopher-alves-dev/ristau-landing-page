---
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { Font } from "astro:assets";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  siteName?: string;
}

const { title, description, noindex, siteName } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.jpg", Astro.site);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    {siteName && <meta property="og:site_name" content={siteName} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Capas de Kindle em crochê da Ristau" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
    <Font cssVariable="--font-dm-sans" preload />
    <Font cssVariable="--font-fraunces" preload />
  </head>
  <body>
    <slot />
    {
      !noindex && (
        <>
          <Analytics />
          <SpeedInsights />
        </>
      )
    }
  </body>
</html>
